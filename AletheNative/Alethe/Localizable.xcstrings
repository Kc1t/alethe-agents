      }
    },
    "features.gsdSync.models.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child session always tries the model the main conversation just used first. This list is a safety net for when that model also fails (a rate limit, say); each is tried in order. Applies to the next OpenCode start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão-filha sempre tenta primeiro o modelo que a conversa principal acabou de usar. Esta lista é a rede de segurança para quando esse modelo também falhar (um limite de uso, por exemplo); cada um é tentado em ordem. Vale a partir do próximo início do OpenCode."
          }
        }
      }
    },
