    "settings.orchestration.orchestrationRoleNameInvalid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a unique name without spaces that does not start with \"-\". Until then the role keeps its saved name, which is the one planners use."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um nome único, sem espaços e que não comece com \"-\". Até lá o papel mantém o nome salvo, que é o que o planner usa."
          }
        }
      }
    },
    "settings.orchestration.orchestrationRoles" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roles"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papéis"
          }
        }
      }
    },
    "settings.orchestration.orchestrationRolesDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A planner that delegates with a role gets exactly what the role sets: agent, model, effort, read-only and budget. It cannot change them in the call."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um planner que delega com um papel recebe exatamente o que o papel define: agente, modelo, esforço, somente leitura e orçamento. Ele não pode mudar isso na chamada."
          }
        }
      }
    },
    "settings.orchestration.orchestrationRolesEmpty" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No roles yet. Until you add one, planners pick the model and effort themselves."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum papel ainda. Até você criar um, o planner escolhe o modelo e o esforço por conta própria."
          }
        }
      }
    },
    "settings.orchestration.orchestrationRouting" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routing"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roteamento"
          }
        }
      }
    },
    "settings.orchestration.orchestrationRoutingDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which role a delegated call runs as when the planner leaves the choice to Alethe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com qual papel uma chamada delegada roda quando o planner deixa a escolha para o Alethe."
          }
        }
      }
    },
    "settings.orchestration.orchestrationRoutingIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The planner classifies each delegated task by kind and effort; Alethe walks the rules in order and the first enabled match picks the role. A role or model named in the call always wins."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O planner classifica cada tarefa delegada por tipo e esforço; o Alethe percorre as regras em ordem e a primeira regra ativa que combina escolhe o papel. Um papel ou modelo nomeado na chamada sempre vence."
          }
        }
      }
    },
