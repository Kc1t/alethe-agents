      }
    },
    "editor.advanced.migrateHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate action from the option above: moves terminals that already exist into isolated worktrees now. This is disruptive — the PTY is suspended and the agent restarts from scratch in the new folder, with no conversation continuity."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ação separada da opção acima: move os terminais que já existem pra worktrees isoladas agora. É disruptivo — o PTY é suspenso e o agente reinicia do zero na pasta nova, sem continuidade de conversa."
          }
        }
      }
    },
    "editor.advanced.migrateConfirm" : {
      "localizations" : {
        "en" : {
