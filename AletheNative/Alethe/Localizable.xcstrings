    "features.gsdSync.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracks the isolated child sessions OpenCode runs while planning, and shows their activity live. Only appears in projects with an OpenCode terminal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanha as sessões filhas isoladas que o OpenCode roda durante o planejamento e mostra a atividade delas ao vivo. Só aparece em projetos com um terminal OpenCode."
          }
        }
      }
    },
