    "browser.resourceModeDescription.appFirst" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommended. Hidden pages release their native webview after 1 second and reload when shown again."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomendado. Páginas ocultas liberam a webview nativa após 1 segundo e recarregam ao reaparecer."
          }
        }
      }
    },
    "browser.resourceModeDescription.balanced" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps hidden pages alive for 30 seconds before releasing their native webview."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém páginas ocultas ativas por 30 segundos antes de liberar a webview nativa."
          }
        }
      }
    },
    "browser.resourceModeDescription.keepAlive" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps hidden pages loaded, but still releases them if Alethe detects memory pressure."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém páginas ocultas carregadas, mas ainda as libera se o Alethe detectar pressão de memória."
