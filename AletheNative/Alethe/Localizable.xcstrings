    "router9.securityNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9router has known security advisories. Alethe never installs or updates it on its own, only routes over loopback, and never enables its remote sharing feature. Read the advisories before routing real credentials through it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O 9router tem vulnerabilidades públicas conhecidas. O Alethe nunca instala nem atualiza sozinho, só roteia por loopback e nunca liga o compartilhamento remoto dele. Leia os avisos antes de rotear credenciais de verdade."
          }
        }
      }
    },
