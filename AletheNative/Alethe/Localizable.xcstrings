    "settings.remote.securityNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per-device sessions, input sanitizing, connection limits and restrictive response headers are always on. The connection itself is not encrypted: anyone who can capture traffic on this network can read the terminal output a paired device sees."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões por dispositivo, sanitização de entrada, limite de conexões e headers restritivos ficam sempre ativos. A conexão em si não é criptografada: quem conseguir capturar o tráfego desta rede consegue ler a saída dos terminais que o dispositivo pareado vê."
          }
        }
      }
    },
    "settings.remote.securityNoteTailscale" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per-device sessions, input sanitizing, connection limits and restrictive response headers are always on. Traffic is also encrypted end to end by WireGuard while reach is set to Tailscale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões por dispositivo, sanitização de entrada, limite de conexões e headers restritivos ficam sempre ativos. O tráfego também é criptografado ponta a ponta pelo WireGuard enquanto o alcance estiver em Tailscale."
          }
        }
      }
    },
