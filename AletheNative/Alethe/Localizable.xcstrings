      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup models for the child session, tried in order if the mirrored model fails."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos reserva para a sessão-filha, tentados em ordem se o modelo espelhado falhar."
          }
        }
      }
    },
    "features.gsdSync.models.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fallback configured — only the mirrored model is tried."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum fallback configurado — só o modelo espelhado é tentado."
          }
