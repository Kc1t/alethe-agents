    "settings.remote.enable.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alethe will listen on this Mac's local network address, and paired devices will see the terminals you share. Traffic on the local network is not encrypted — only turn this on in a network you trust."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alethe vai escutar no endereço de rede local deste Mac, e os dispositivos pareados vão ver os terminais que você compartilhar. O tráfego na rede local não é criptografado — só ligue isto numa rede em que você confia."
          }
        }
      }
    },
    "settings.remote.enable.warningTailscale" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alethe will listen on this Mac's Tailscale address, reachable from every device on your tailnet, and paired devices will see the terminals you share. If Tailscale is not running, remote control does not start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alethe vai escutar no endereço Tailscale deste Mac, alcançável por qualquer dispositivo da sua tailnet, e os dispositivos pareados vão ver os terminais que você compartilhar. Se o Tailscale não estiver rodando, o controle remoto não liga."
          }
        }
      }
    },
