{
  "name": "alethe",
  "version": "1.6.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.json",
    "smoke:ghostty": "bash scripts/smoke-ghostty.sh",
    "capture:window": "bash scripts/capture-window.sh",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:ghostty": "cd src-tauri && cargo test --lib -- --ignored --test-threads=1 terminal_runs",
    "test": "vitest run",
    "test:e2e:build": "npm run build && cross-env CARGO_TARGET_DIR=target-e2e tauri build --debug --no-bundle",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "test:e2e:git-pipeline": "wdio run e2e/wdio.conf.ts --spec e2e/specs/git-pipeline.spec.ts",
    "replay:record": "wdio run e2e/wdio.conf.ts --spec e2e/specs/_record.spec.ts",
    "replay": "wdio run e2e/wdio.conf.ts --spec e2e/specs/_replay.spec.ts",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/cytoscape": "^3.21.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "cytoscape": "^3.34.0",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.15.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^4.10.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "cross-env": "^10.1.0",
    "webdriverio": "^9.30.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "terser": "^5.48.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
