# Optional local Spotify fallback for development.
# Public builds should rely on Preferences > Spotify instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Alethe cloud sync server (GitHub sign-in in onboarding and Sync).
# Leave unset to hide cloud sign-in. Example for a local server: http://127.0.0.1:8787
ALETHE_SYNC_SERVER=
