{
  "name": "@alethe/rendezvous-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:local:smoke": "node --experimental-websocket test/run-local-smoke.mjs",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
